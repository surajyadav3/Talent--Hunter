{
    "version": 2,
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/assets/(.*)",
            "destination": "/frontend/dist/assets/$1"
        },
        {
            "source": "/(.*)\\.(ico|png|svg|jpg|jpeg|gif|txt|json)",
            "destination": "/frontend/dist/$1.$2"
        },
        {
            "source": "/((?!api/|assets/).*)",
            "destination": "/frontend/dist/index.html"
        }
    ]
}